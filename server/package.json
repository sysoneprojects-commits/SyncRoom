{
  "name": "syncroom-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply syncroom-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply syncroom-db --remote"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.123.0"
  }
}
